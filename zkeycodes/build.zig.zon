.{
    .name = .zkeycodes,
    .version = "0.1.0",
    .fingerprint = 0xd829e8133e5db3ac,
    .minimum_zig_version = "0.17.0",
    // zigmkay is not a package dependency: zkeycodes lives inside the
    // zigmkay_firmware package, which depends on it, so a dependency back on
    // that package would be circular. Its standalone build uses the zigmkay
    // source next to it (../src), and the parent package injects its own
    // zigmkay module when building firmware.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "keycodes",
        "root.zig",
        "qmk_imports",
        "test_data",
        "test_generation.zig",
        "test_labels.zig",
    },
}

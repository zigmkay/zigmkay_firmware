    .{ .key_index = 27, .x = 9, .y = 2.25, .hand = .right },
    .{ .key_index = 28, .x = 4.14, .y = 3.72, .hand = .left, .group = .thumb },
    .{ .key_index = 29, .x = 5.86, .y = 3.72, .hand = .right, .group = .thumb },
}
